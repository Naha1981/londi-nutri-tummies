# ── Database (required) ──────────────────────────────────────────────
# Local dev: SQLite file. Production (Vercel): hosted Postgres URL
# (Neon / Supabase / Vercel Postgres) — serverless has no persistent disk.
DATABASE_URL=file:./db/custom.db

# ── App URL (recommended in production) ─────────────────────────────
# Used to build payment return/cancel/webhook URLs. Falls back to the
# request's host when unset (works on Vercel preview deployments).
# NEXT_PUBLIC_APP_URL=https://your-domain.co.za

# ── Payments (optional — demo mode until set) ───────────────────────
# PayFast (https://payfast.io) — merchant credentials from Settings → Integration
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_MODE=sandbox   # sandbox | live

# Yoco (https://yoco.com/za/developers) — secret key from the developer dashboard
# YOCO_SECRET_KEY=

# With NO payment keys set, the app runs in demo checkout mode: upgrades are
# simulated and clearly labelled. Setting either provider's keys switches all
# checkout buttons to live provider flow automatically — no code changes.
